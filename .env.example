# =========================================
# Example environment variables
# Copy to `.env` and fill in real values:
#   cp .env.example .env
# Load before running scripts:
#   export $(cat .env | xargs)
# =========================================

# MariaDB / MySQL credentials (only needed if configs/*.yaml has database.enabled: true)
HERDING_DB_HOST=127.0.0.1
HERDING_DB_USER=trader
HERDING_DB_PASSWORD=your_db_password_here
HERDING_DB_NAME=trading

# X (Twitter) API — only needed for src/x_*.py modules
# Get from https://developer.twitter.com/
# X_BEARER_TOKEN=your_bearer_token_here
