# =========================================
# Heavy research outputs / experiments
# =========================================
# Generated outputs are opt-in: use `git add -f` only for reviewed reports,
# decisions, manifests, and plots. Already tracked historical files are unaffected.
outputs/**
experiments/**/outputs/**

# Large or regenerable research artifacts are never public by default.
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz
*.jsonl
**/intermediate/
**/.staging-*/
**/staging/
*.tmp
*.part
